# Expense Tracker System Environment Configuration
# Copy this file to .env if you need to customize settings

# Currency symbol or code (Default: Rs.)
EXPENSE_TRACKER_CURRENCY=Rs.

# Default Database Storage Path (Default: data/expenses.db)
EXPENSE_TRACKER_DB_PATH=data/expenses.db

# Reports Output Directory (Default: reports)
EXPENSE_TRACKER_REPORTS_DIR=reports
